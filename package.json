{
  "name": "react-theme-tide",
  "version": "0.3.0",
  "description": "Theme changes that rise up the screen like water, on the web and in React Native.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alawonn/react-theme-tide.git"
  },
  "homepage": "https://github.com/alawonn/react-theme-tide#readme",
  "bugs": {
    "url": "https://github.com/alawonn/react-theme-tide/issues"
  },
  "keywords": [
    "react",
    "theme",
    "dark-mode",
    "view-transitions",
    "animation",
    "react-native",
    "expo"
  ],
  "exports": {
    ".": {
      "browser": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "react-native": {
        "types": "./dist/native/index.d.ts",
        "default": "./dist/native/index.js"
      },
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "react-native": "./dist/native/index.js",
  "files": [
    "dist/*.js",
    "dist/*.d.ts",
    "dist/native/*.js",
    "dist/native/*.d.ts"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p demo/tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:browser": "playwright test",
    "demo": "vite --config demo/vite.config.ts",
    "demo:build": "vite build --config demo/vite.config.ts",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-native": ">=0.79.0",
    "@shopify/react-native-skia": ">=2.0.0",
    "react-native-reanimated": ">=4.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@shopify/react-native-skia": "^2.6.2",
    "@types/node": "^24.19.2",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^30.1.3",
    "pngjs": "^7.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-native": "^0.86.3",
    "react-native-reanimated": "^4.5.1",
    "react-native-worklets": "^0.10.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  },
  "peerDependenciesMeta": {
    "react-native": {
      "optional": true
    },
    "@shopify/react-native-skia": {
      "optional": true
    },
    "react-native-reanimated": {
      "optional": true
    }
  }
}
